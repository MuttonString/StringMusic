{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "String Music",
  "version": "1.0.0",
  "identifier": "com.muttonstring.string-music",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "String Music",
        "width": 800,
        "height": 600,
        "minWidth": 400,
        "minHeight": 400,
        "transparent": true,
        "visible": false,
        "hiddenTitle": true,
        "titleBarStyle": "Overlay"
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "deb", "rpm"],
    "publisher": "Mutton String",
    "windows": {
      "nsis": {
        "installMode": "both",
        "languages": [
          "Arabic",
          "Dutch",
          "English",
          "French",
          "German",
          "Italian",
          "Japanese",
          "Korean",
          "Norwegian",
          "Portuguese",
          "PortugueseBR",
          "Russian",
          "SimpChinese",
          "Spanish",
          "SpanishInternational",
          "Swedish",
          "TradChinese",
          "Turkish",
          "Ukrainian"
        ]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/32x32@2x.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/256x256.png",
      "icons/256x256@2x.png",
      "icons/512x512.png",
      "icons/512x512@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
